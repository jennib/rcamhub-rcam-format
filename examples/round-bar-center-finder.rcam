    {
      "id": "var-run",
      "name": "run",
      "expr": "fenceLen / 2 ^ 0.5",
      "value": 0
    },
    {
      "id": "var-tailW",
      "name": "tailW",
      "expr": "slotW + 2 * wall",
      "value": 0
    },
    {
      "id": "var-slotStart",
      "name": "slotStart",
      "expr": "seat + barMin / 2 ^ 0.5 - reach",
      "value": 0
    },
    {
      "id": "var-slotEnd",
      "name": "slotEnd",
      "expr": "seat + barMax / 2 * (2 ^ 0.5 + 1)",
      "value": 0
    },
    {
      "id": "var-slotLen",
      "name": "slotLen",
      "expr": "slotEnd - slotStart",
      "value": 0
    },
    {
      "id": "var-tailLen",
      "name": "tailLen",
      "expr": "slotEnd + wall - (2 * run - tailW / 2)",
      "value": 0
    },
    {
      "id": "var-pinX",
      "name": "pinX",
      "expr": "(fenceLen - pinAt + lipW / 2) / 2 ^ 0.5",
      "value": 0
    },
    {
      "id": "var-pinY",
      "name": "pinY",
      "expr": "(fenceLen - pinAt - lipW / 2) / 2 ^ 0.5",
      "value": 0
    }
  ],
